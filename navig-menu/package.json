{
  "name": "navig-menu",
  "version": "1.7.0",
  "description": "AI-first menu builder — auto-detects any project's stack and builds a premium interactive terminal menu with layouts, a plugin system, and a live settings panel. Standalone or via `navig menu`.",
  "type": "module",
  "license": "MIT",
  "author": "Cybesis Studio (miztizm)",
  "homepage": "https://navig.run/menu",
  "repository": {
    "type": "git",
    "url": "https://github.com/navig-run/menu.git"
  },
  "bugs": {
    "url": "https://github.com/navig-run/menu/issues"
  },
  "keywords": [
    "cli",
    "menu",
    "tui",
    "monorepo",
    "package-manager",
    "developer-tools",
    "terminal",
    "plugins",
    "navig"
  ],
  "bin": {
    "navig-menu": "dist/cli.js",
    "nm": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./menu-builder": {
      "types": "./dist/menu-builder.d.ts",
      "import": "./dist/menu-builder.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "binaries": "node --experimental-strip-types scripts/build-binaries.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "enquirer": "^2.4.1",
    "execa": "^9.5.2",
    "fflate": "^0.8.2",
    "fuse.js": "^7.0.0",
    "smol-toml": "^1.7.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
