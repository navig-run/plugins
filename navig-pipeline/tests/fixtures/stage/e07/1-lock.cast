[4.207965, "o", "  \u001b[2mhost \u001b[0m\u001b[2;32m'prod-01'\u001b[0m\u001b[2m is being operated by \u001b[0m\r\n\u001b[2manother session\u001b[0m\r\n\u001b[2m  session : navig-showcase\u001b[0m\r\n\u001b[2m  who     : root@workstation\u001b[0m\r\n\u001b[2m  since   : \u001b[0m\u001b[1;2;36m2026\u001b[0m\u001b[2m-\u001b[0m\u001b[1;2;36m10\u001b[0m\u001b[2m-10T\u001b[0m\u001b[1;2;92m12:16:59\u001b[0m\u001b[2m.\u001b[0m\u001b[1;2;36m402549\u001b[0m\u001b[2m+\u001b[0m\u001b[1;2;92m00:00\u001b[0m\r\n\u001b[1;2m(\u001b[0m\u001b[2mactive \u001b[0m\u001b[1;2;36m0.\u001b[0m\u001b[2m0m ago\u001b[0m\u001b[1;2m)\u001b[0m\r\n\u001b[2m  command : navig run: uptime\u001b[0m\r\n\u001b[2m  kind    : implicit \u001b[0m\u001b[1;2m(\u001b[0m\u001b[2mfrees after 20m idle\u001b[0m\u001b[1;2m)\u001b[0m\r\n\r\n\u001b[2mOptions:\u001b[0m\r\n\u001b[2m  • wait — the lock frees the moment that \u001b[0m\r\n\u001b[2msession ends, or after 20m of inactivity\u001b[0m\r\n\u001b[2m  • navig host lock status prod-\u001b[0m\u001b[1;2;36m01\u001b[0m\u001b[2m      \u001b[0m\r\n\u001b[1;2m(\u001b[0m\u001b[2minspect\u001b[0m\u001b[1;2m)\u001b[0m\r\n\u001b[2m  • navig host lock release prod-\u001b[0m\u001b[1;2;36m01\u001b[0m\u001b[2m --force \u001b[0m\r\n\u001b[1;2m(\u001b[0m\u001b[2monly if that session is dead\u001b[0m\u001b[1;2m)\u001b[0m\r\n\u001b[2m  • \u001b[0m\u001b[2;33mNAVIG_HOST_LOCK\u001b[0m\u001b[2m=\u001b[0m\u001b[2;35mwarn\u001b[0m\u001b[2m navig \u001b[0m\u001b[2;33m...\u001b[0m\u001b[2m     \u001b[0m\r\n\u001b[1;2m(\u001b[0m\u001b[2mproceed anyway, this once\u001b[0m\u001b[1;2m)\u001b[0m\r\n"]
