# =============================================================
# NAVIG Mini — .env example
# Copy to .env in the same directory as agent.py, fill in values.
# Secrets never leave this file — sourced by stdlib only, no injection.
# =============================================================

# ── Agent ─────────────────────────────────────────────────────
AGENT_PORT=9191                          # HTTP port for agent API
AGENT_BIND=0.0.0.0                       # 127.0.0.1 = local-only; 0.0.0.0 requires a strong AGENT_SECRET
AGENT_SECRET=changeme-generate-with-python3-secrets  # HMAC secret — REQUIRED: replace with a real one:
                                         #   python3 -c "import secrets; print(secrets.token_hex(32))"
                                         # A "changeme…" or <16-char value REFUSES to serve on a non-loopback bind.
AGENT_HOSTNAME=my-device                 # Label in Telegram messages
AGENT_DISK_PATH=/                        # Path for disk usage stats

# ── Telegram alerts (optional — leave blank to disable all) ───
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ── Alert thresholds ──────────────────────────────────────────
DISK_ALERT_THRESHOLD=92                  # % usage before alert fires
RAM_ALERT_THRESHOLD=50                   # MB free before alert fires

# ── Watchdog (optional) ───────────────────────────────────────
# JSON: {"proc_name": "restart_shell_command"}
# Example for Pi running nginx + postgres:
# AGENT_WATCHDOG={"nginx":"systemctl restart nginx","postgres":"pg_ctl start"}
AGENT_WATCHDOG={}

# ── Monitor: services to check ────────────────────────────────
# JSON: {"proc_name": "http_health_url_or_empty"}
# Example:
# MONITOR_SERVICES={"nginx":"http://127.0.0.1:80","redis":""}
MONITOR_SERVICES={}

# ── Monitor: watch directory for new files ────────────────────
# MONITOR_WATCH_DIR=/home/user/Downloads
MONITOR_WATCH_DIR=

# ── Monitor: state and log files ──────────────────────────────
MONITOR_STATE_FILE=/tmp/navig_mini_monitor_state.json
MONITOR_LOG_FILE=                        # blank = stdout only

# ── Extra allowed command prefixes (space-separated) ──────────
# AGENT_SAFE_PREFIXES_EXTRA=/home/pi/scripts/ /opt/local/bin/
AGENT_SAFE_PREFIXES_EXTRA=

# ── Optional: paths override ──────────────────────────────────
# NAS_ROOT=/data/public                  # adds sh NAS_ROOT/* to allowlist
NAS_ROOT=
