    "events": "POST /api/deck/agents/events (Agent Monitor ingestion — one event or {events:[≤50]}; idempotent on event_id; all-or-nothing validation)",
    "runs": "GET /api/deck/agents/runs[?project=&state=&kind=&active=1&limit=] · GET /api/deck/agents/runs/summary · GET /api/deck/agents/runs/{run_id}[?log=1] · POST /api/deck/agents/runs/{run_id}/ack"
